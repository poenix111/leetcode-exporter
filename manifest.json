{
  "manifest_version": 3,
  "name": "LeetCode to PDF",
  "version": "1.1.0",
  "description": "Export LeetCode problem descriptions and code solutions to a clean PDF or source file.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "highlight.min.js",
        "code-themes.js",
        "content.js"
      ],
      "css": ["content-button.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "scripting"]
}
